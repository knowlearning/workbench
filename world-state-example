name: Vector Frogs
collider1:
  position: [200, 100]
  polygon:
    - [-5, 5]
    - [ 5, 5]
    - [ 5, -5]
    - [-5, -5]
  angle: 0
frog1:
  text:
    value: Hello World
    font: bold 16px Arial
    fillStyle: orange
    strokeStyle: black
    lineWidth: 1
    align: center
    baseline: middle
    offset: [0, 75]
  physics:
    follow:
      position: [2, 0] # target position in own coordinates
      angle: 0 # target angle in parent
      stiffness: 1 # defines strength of pull
      damping: 1 # defines friciton like behavior
      angularStiffness: 1 # strenth of rotational pull
      angularDamping: 1 # defines friciton like behavior
  reactions:
    keydown: |
      // js
      if (event.key === 'ArrowLeft') this.position[0] -= 10
      if (event.key === 'ArrowRight') this.position[0] += 10
      if (event.key === 'ArrowUp') this.position[1] -= 10
      if (event.key === 'ArrowDown') this.position[1] += 10
      this.text.value = 'wooo! ' + event.key
    touch: |
      // js
      const isTouching = pointInObject(event, this)
      this.dragging = isTouching
      if (isTouching) {
        this.angle += 30
        this.drags += 1
        this.text.value = this.drags
      }
    untouch: |
      // js
      if (this.dragging) {
        this.angle -= 30

        if (!this.hopping) {
          this.hopping = true
          this.hopStart = performance.now()
          this.hopDuration = 1 // seconds
          this.hopStartPos = [...this.position]
          this.hopTarget = [this.position[0] + 200, this.position[1]]

          this.g = 600

          const dx = this.hopTarget[0] - this.hopStartPos[0]
          const dy = this.hopTarget[1] - this.hopStartPos[1]

          this.vx = dx / this.hopDuration
          this.vy = (dy - 0.5 * this.g * this.hopDuration * this.hopDuration) / this.hopDuration

          console.log('hopping to', this.hopTarget, 'in', this.hopDuration, 's')
        }
      }
      this.dragging = false
    drag: |
      // js
      if (this.dragging) {
        this.position[0] += event.dx
        this.position[1] += event.dy
      }
    collide: |
      // js
      if (event.colliders.includes(this)) this.sprite.scale *= 1.1
    uncollide: |
      // js
      if (event.colliders.includes(this)) this.sprite.scale /= 1.1
    step: |
      // js
      if (this.hopping) {
        const t = (performance.now() - this.hopStart) / 1000 // elapsed in seconds
        if (t >= this.hopDuration) {
          // finished
          this.position[0] = this.hopTarget[0]
          this.position[1] = this.hopTarget[1]
          this.hopping = false
          this.sprite.state = 'example1'
        } else {
          // projectile motion with gravity
          this.position[0] = this.hopStartPos[0] + this.vx * t
          this.position[1] = this.hopStartPos[1] + this.vy * t + 0.5 * this.g * t * t
        }
      }
  position: [100, 100]
  angle: 0
  polygon:
    - [-50, 50]
    - [ 50, 50]
    - [ 50, -50]
    - [-50, -50]
  sprite:
    state: example1
    frame: 0
    scale: 0.15
    definition:
      sheet: 19445ec0-07a7-11f1-861d-899b3d78cc14
      states:
        example1:
          frames: [
            [0, 100, 1150, 860]
          ]
          fps: 6
          loop: true