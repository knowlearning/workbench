name: example 1
drag: |
  // js
  if (object.dragging) {
    object.position[0] += event.dx
    object.position[1] += event.dy
  }
touch: |
  object.dragging = true
  object.whatever.embedded.whatever.sprite.state.name = 'example2'
untouch: |
  object.dragging = false
  object.whatever.embedded.whatever.sprite.state.name = 'example1'
