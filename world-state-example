name: Vector Frogs
frog1:
  drags: 0
  text:
    value: Hello World
    font: bold 16px Arial
    fillStyle: orange
    strokeStyle: black
    lineWidth: 1
    align: center
    baseline: middle
    offset: [0, 75]
  handleEvent: |
      // js
      if (event.type === 'keypress') {
        object.text.value = 'wooo!'
      }
      else if (event.type === 'touch') {
        const isTouching = pointInObject(event, object)
        object.dragging = isTouching
        if (isTouching) object.angle += 30
      }
      else if (event.type === 'untouch') {
        if (object.dragging) object.angle -= 30
        object.dragging = false
      }
      else if (event.type === 'drag' && object.dragging) {
        object.position[0] += event.dx
        object.position[1] += event.dy
      }
  position: [100, 100]
  jump: |
    // js
  timeline:
    - |
      // js
      object.jump(parabola) # if function returns a promise, timeline execution will halt until promise returns
  angle: 0
  polygon:
    - [-50, 50]
    - [ 50, 50]
    - [ 50, -50]
    - [-50, -50]
  sprite:
    state: example1
    frame: 0
    scale: 0.15
    definition:
      sheet: 09836b70-7d87-11f0-a1e0-a7c6465c8684
      states:
        example1:
          frames: [
            [0, 100, 1150, 860]
          ]
          fps: 6
          loop: true
