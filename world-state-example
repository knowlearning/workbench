name: example 1
drag: |
  // js
  if (object.dragging) {
    object.position[0] += event.dx
    object.position[1] += event.dy
  }
touch: |
  object.dragging = true
  object.angle += 30
  const newObject = JSON.parse(JSON.stringify(object))
  newObject.position = [
    newObject.position[0] + 20,
    newObject.position[1] + 20,
  ]
  object[Math.random()] = newObject
untouch: |
  object.dragging = false
  object.angle -= 30
path: [
  [-10, -10],
  [10, -10],
  [10, 10],
  [-10, 10]
]
position: [ 100, 0 ]
angle: 90
